# Copy this file to .env and fill in the values you need.
# Never commit your real .env file.

# Which LLM provider to use: mock | anthropic | openai | gemini | groq | openrouter
# "mock" requires no API key and runs the full pipeline offline (useful for
# trying out the app and for the automated test suite).
LLM_PROVIDER=mock

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Required if LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Required if LLM_PROVIDER=groq
# Groq uses its OpenAI-compatible API endpoint.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Required if LLM_PROVIDER=openrouter
# OpenRouter uses its OpenAI-compatible API endpoint and model slugs.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
